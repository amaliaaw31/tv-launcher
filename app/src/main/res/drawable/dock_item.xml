<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#E6FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <!-- Dock tile (v1.9): dense dark slate (~90% -> ~85% alpha),
             same recipe as the home cards, so the tile stays readable
             over bright scenes now that the dock has no bar behind it.
             The focused state above (solid light tile, label turns
             black) is unchanged. -->
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:endColor="#D90B1219"
                android:startColor="#E6141C26"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
</selector>
