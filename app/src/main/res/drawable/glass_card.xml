<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphism card (v1.8): DARK smoky glass — the v1.5-v1.7 white
     translucent fill washed out over bright scene photos and made the
     white text unreadable (user photo 2026-10-28). Now a dark slate
     gradient so the wallpaper still shows through but text stays crisp.
     Border and corners unchanged. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:endColor="#4D141C26"
        android:startColor="#66202B38"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />
</shape>
