<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphism card (v1.9): MUCH denser dark slate than v1.8.
     Review point 2: the old 30-40% alpha fill let bright wallpaper
     areas wash the white text out (contrast ~2:1). Fill is now
     ~90% -> ~85% alpha of the same dark slate, so text stays crisp
     while a hint of the scene still shows through. Border/corners
     unchanged. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:endColor="#D90B1219"
        android:startColor="#E6141C26"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />
</shape>
