<?xml version="1.0" encoding="utf-8"?>
<!-- Gear chip in the Settings header card (v1.7): translucent teal glass. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="9dp" />
    <gradient
        android:angle="270"
        android:endColor="#4D0E7490"
        android:startColor="#800E7490"
        android:type="linear" />
