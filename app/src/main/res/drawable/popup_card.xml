<?xml version="1.0" encoding="utf-8"?>
<!-- Quake popup card (v1.7): glass version of the alert card — the fill
     is now a translucent red-tinted glass gradient instead of a solid,
     while the 2dp red alert border is kept so the warning identity and
     readability over playing video stay intact. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:angle="270"
        android:endColor="#D92A0A10"
        android:startColor="#E63A0E14"
        android:type="linear" />
    <stroke android:width="2dp" android:color="#FF5252" />
</shape>
