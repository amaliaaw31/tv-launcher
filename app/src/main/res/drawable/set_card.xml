<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card for Settings (v1.9): dense dark slate, same recipe as
     the home glass_card (~90% -> ~85% alpha), so the header card and
     phone-pairing panel stay readable over the wallpaper photo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:endColor="#D90B1219"
        android:startColor="#E6141C26"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />
</shape>
