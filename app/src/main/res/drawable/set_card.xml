<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card for Settings (v1.8): dark smoky glass, same recipe as
     the home glass_card, so the header card and phone-pairing panel stay
     readable over the real wallpaper photo now used as the backdrop. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:endColor="#4D141C26"
        android:startColor="#66202B38"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />
</shape>
