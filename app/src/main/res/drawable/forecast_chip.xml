<?xml version="1.0" encoding="utf-8"?>
<!-- Forecast chip (v1.9): same dense dark slate as glass_card
     (~90% -> ~85% alpha) so day labels and temperatures stay readable
     over bright scenes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:angle="270"
        android:endColor="#D90B1219"
        android:startColor="#E6141C26"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />
</shape>
