<?xml version="1.0" encoding="utf-8"?>
<!-- Forecast chip (v1.8): same dark smoky glass as glass_card, so the
     day labels and temperatures stay readable over bright scenes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:angle="270"
        android:endColor="#4D141C26"
        android:startColor="#66202B38"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />
</shape>
