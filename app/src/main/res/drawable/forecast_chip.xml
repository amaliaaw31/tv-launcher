<?xml version="1.0" encoding="utf-8"?>
<!-- Forecast chip (v1.9): same dense dark slate as glass_card
     (~90% -> ~85% alpha) so day labels and temperatures stay readable
     over bright scenes.
     v2.2 (point 6): resting stroke calmed to ~20% white, same as
     glass_card — cells are never focusable, so they never show the
     cyan focus outline; this keeps their border quiet too. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:angle="270"
        android:endColor="#D90B1219"
        android:startColor="#E6141C26"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
