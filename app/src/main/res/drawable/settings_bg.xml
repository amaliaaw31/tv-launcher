<?xml version="1.0" encoding="utf-8"?>
<!-- Settings backdrop (v1.7): a dark multi-stop "blurred scene" gradient
     standing in for a blurred wallpaper, so the glass panes/cards on top
     read as frosted glass exactly like the home cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#0B1220"
        android:centerColor="#173549"
        android:endColor="#081018"
        android:type="linear" />
</shape>
