<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row (v1.8): dark smoky glass fill + bright border; the
     focused row keeps the 2dp teal border so D-pad focus stays
     unmistakable over the wallpaper photo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:endColor="#66141C26"
                android:startColor="#80202B38"
                android:type="linear" />
            <stroke android:width="2dp" android:color="#22D3EE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:endColor="#4D141C26"
                android:startColor="#66202B38"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
        </shape>
    </item>
</selector>
