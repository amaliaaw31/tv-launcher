<?xml version="1.0" encoding="utf-8"?>
<!-- Focused variant of glass_card (v1.9): same dense slate, slightly
     brighter, with the 2dp teal border so D-pad focus on a home card
     (OK = retry / open detail) is unmistakable. Swapped in by
     MainActivity's focus listeners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:endColor="#E60B1219"
        android:startColor="#F0141C26"
        android:type="linear" />
    <stroke
        android:width="2dp"
        android:color="#22D3EE" />
</shape>
