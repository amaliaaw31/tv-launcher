<?xml version="1.0" encoding="utf-8"?>
<!-- Clock-area scrim (v1.9, review point 2): soft black gradient
     behind the left clock/date/forecast column. Starts at ~72% black
     on the far left and is fully transparent by 55% of the width, so
     the greeting/clock/date/forecast text keeps contrast over bright
     wallpaper areas without a visible panel edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerColor="#00000000"
        android:centerX="0.55"
        android:endColor="#00000000"
        android:startColor="#B8000000"
        android:type="linear" />
</shape>
