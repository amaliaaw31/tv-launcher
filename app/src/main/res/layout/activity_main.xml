<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/jakarta_cerah" />

    <View
        android:id="@+id/tintView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000" />

    <!-- v1.9 (point 2): clock-area scrim — soft dark gradient behind the
         left column, fading out by ~55% width, so clock/date/forecast
         keep contrast over bright wallpaper areas. -->
    <View
        android:id="@+id/clockScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_clock" />

    <!-- Content: main row fills the whole screen now. v2.1 (point 2):
         the dock is no longer a fixed-height strip in the flow — it
         is a hidden overlay tray (see dockPanel at the bottom), so
         the main row reclaims the full height. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- left: greeting + clock + date + forecast, plain text, no panel -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/greetingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#AA000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/clockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:shadowColor="#AA000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="8"
                    android:textColor="#FFFFFF"
                    android:textSize="112sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#AA000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#F5F5F5"
                    android:textSize="21sp" />

                <!-- 4-day forecast, filled by MainActivity as a
                     2x2 GRID (v2.1, point 3): two rows of two cells
                     built in code into this vertical container.
                     (v1.8-v2.0 was a single horizontal strip of four
                     weighted chips.)
                     v2.2 (point 1): the grid is narrowed to 78% of
                     the left column's content width (within the
                     75-80% band), left-aligned with the date text
                     above it — the weighted spacer absorbs the rest,
                     so the cells get closer to square. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/forecastRow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="78"
                        android:orientation="vertical" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="22" />
                </LinearLayout>
            </LinearLayout>

            <!-- right: compact widget cards.
                 The top padding (v1.5) pushes the first card fully below
                 the top-right Input + gear row (marginTop 20dp + 36dp tall
                 + 12dp gap), so a card never sits beside or behind the
                 buttons.
                 v2.1 (QA-2): the column now sits in a ScrollView. Root
                 cause of the missing volcano strip: this column used to
                 be a plain non-scrolling LinearLayout confined to
                 screen-minus-dock height; when v1.9's status lines +
                 quake hint + larger text grew the first three cards
                 past the available height, the LAST child (volcano
                 strip) was laid out beyond the bottom edge and clipped
                 — in the tree, but never painted. The ScrollView is the
                 structural guarantee (D-pad focus scrolls it into
                 view); the card spacing trims below + the reclaimed
                 dock height make all four cards fit without scrolling
                 in the normal case. -->
            <ScrollView
                android:layout_width="330dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="27dp"
                android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="vertical"
                android:paddingTop="68dp"
                android:paddingBottom="10dp">

                <!-- weather card (v2.2, point 3): SUMMARIZED face —
                     title, main line (temp + condition), city, OK
                     hint, status line. The AQI/PM2.5 line moved into
                     the weather detail dialog (OK opens it). Height
                     wraps content like every card (v2.0 point 1) — no
                     fixed/min height anywhere in this column. -->
                <LinearLayout
                    android:id="@+id/weatherCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/glass_card"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="8dp">

                    <!-- v2.1 (point 1): title gets a decorative line
                         icon (contentDescription=@null — the text
                         label beside it already names the info). -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_title_weather" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weather_title"
                            android:textColor="#B0BEC5"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/weatherMain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loading"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weatherCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#ECEFF1"
                        android:textSize="16sp" />

                    <!-- v2.2 (point 3): the AQI row left the card
                         face; it lives in the weather detail dialog
                         now (with its wind icon's info as text). The
                         hint line takes its place, same style as the
                         quake card's. -->
                    <TextView
                        android:id="@+id/weatherHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/quake_detail_hint"
                        android:textColor="#22D3EE"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/weatherStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/loading"
                        android:textColor="#B0BEC5"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- prayer card (v2.2, point 4): SUMMARIZED face —
                     title, next-prayer line only, OK hint, status
                     line. The full day schedule moved into a dialog
                     (OK opens it). -->
                <LinearLayout
                    android:id="@+id/prayerCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/glass_card"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_title_prayer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/prayer_title"
                            android:textColor="#B0BEC5"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/prayerNext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loading"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/prayerHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/prayer_detail_hint"
                        android:textColor="#22D3EE"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/prayerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/loading"
                        android:textColor="#B0BEC5"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- quake card: readable summary only (short place
                     name, v2.0 point 2); OK opens the COMPLETE detail
                     in a native AlertDialog. Focusable. -->
                <LinearLayout
                    android:id="@+id/quakeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/glass_card"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_title_quake" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quake_title"
                            android:textColor="#B0BEC5"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/quakeMain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/loading"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/quakeSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#ECEFF1"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/quakeHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/quake_detail_hint"
                        android:textColor="#22D3EE"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/quakeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/loading"
                        android:textColor="#B0BEC5"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- volcano strip (v1.9): title + name/level line (15sp)
                     + status line. Focusable: OK refetches volcano. -->
                <LinearLayout
                    android:id="@+id/volcanoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_title_volcano" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/volcano_title"
                            android:textColor="#B0BEC5"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/volcanoText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/loading"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/volcanoStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/loading"
                        android:textColor="#B0BEC5"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- bottom dock (v2.1, point 2): HIDDEN overlay tray. Starts
         GONE — takes no focus, reserves no space. D-pad DOWN from the
         bottom-most main-area element slides it up (~200ms) over the
         wallpaper; UP or BACK slides it away again. The tray glass is
         TRANSPARENT smoky glass (owner rejected an opaque black
         panel); the tiles keep their dense dock_item background so
         icons/labels stay readable. MainActivity drives it. -->
    <FrameLayout
        android:id="@+id/dockPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/dock_panel"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/dockScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dockRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingStart="21dp"
                android:paddingEnd="21dp" />
        </HorizontalScrollView>
    </FrameLayout>

    <!-- top-right: Input pill + gear icon only -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/inputBtn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/pill_button"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_input"
            android:minWidth="84dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="@string/input_label"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/gearBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/pill_button"
            android:contentDescription="@string/settings_title"
            android:padding="8dp"
            android:src="@drawable/ic_gear" />
    </LinearLayout>
</FrameLayout>
