<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/jakarta_cerah" />

    <View
        android:id="@+id/tintView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000" />

    <!-- v1.9 (point 2): clock-area scrim — soft dark gradient behind the
         left column, fading out by ~55% width, so clock/date/forecast
         keep contrast over bright wallpaper areas. -->
    <View
        android:id="@+id/clockScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_clock" />

    <!-- Content: main row (clock + widgets) above a fixed-height dock, so the
         widget column can never spill over the dock; excess is clipped inside
         the row instead. All sizes are the v1.4 ~0.75 scale of the original
         design for the 24" TV. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- left: greeting + clock + date + forecast, plain text, no panel -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/greetingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#AA000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/clockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:shadowColor="#AA000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="8"
                    android:textColor="#FFFFFF"
                    android:textSize="112sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#AA000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#F5F5F5"
                    android:textSize="21sp" />

                <!-- 4-day forecast strip, filled by MainActivity.
                     v1.8: match_parent so the strip spans the whole left
                     column and the 4 weighted chips form ONE row under
                     the date (was wrap_content + fixed-width chips,
                     which let the strip render squeezed/stacked). -->
                <LinearLayout
                    android:id="@+id/forecastRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- right: compact widget cards, confined to the main row.
                 The top padding (v1.5) pushes the first card fully below
                 the top-right Input + gear row (marginTop 20dp + 36dp tall
                 + 12dp gap), so a card never sits beside or behind the
                 buttons. -->
            <LinearLayout
                android:layout_width="330dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="27dp"
                android:gravity="top"
                android:orientation="vertical"
                android:paddingTop="68dp">

                <!-- weather card: title, main line, city, ONE AQI
                     line, status line. Height wraps content like every
                     card (v2.0 point 1) — no fixed/min height anywhere
                     in this column. Focusable: OK refetches weather +
                     air only. -->
                <LinearLayout
                    android:id="@+id/weatherCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/glass_card"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weather_title"
                        android:textColor="#B0BEC5"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/weatherMain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loading"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weatherCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#ECEFF1"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/weatherAqi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#FFD54F"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/weatherStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/loading"
                        android:textColor="#B0BEC5"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- prayer card (v1.9): next-prayer line + one all-times
                     line + status line. Focusable: OK refetches prayer. -->
                <LinearLayout
                    android:id="@+id/prayerCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/glass_card"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prayer_title"
                        android:textColor="#B0BEC5"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/prayerNext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loading"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/prayerAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:textColor="#ECEFF1"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/prayerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/loading"
                        android:textColor="#B0BEC5"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- quake card: readable summary only (short place
                     name, v2.0 point 2); OK opens the COMPLETE detail
                     in a native AlertDialog. Focusable. -->
                <LinearLayout
                    android:id="@+id/quakeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/glass_card"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quake_title"
                        android:textColor="#B0BEC5"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/quakeMain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/loading"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/quakeSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#ECEFF1"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/quakeHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/quake_detail_hint"
                        android:textColor="#22D3EE"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/quakeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/loading"
                        android:textColor="#B0BEC5"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- volcano strip (v1.9): title + name/level line (15sp)
                     + status line. Focusable: OK refetches volcano. -->
                <LinearLayout
                    android:id="@+id/volcanoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/volcano_title"
                            android:textColor="#B0BEC5"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/volcanoText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/loading"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/volcanoStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/loading"
                        android:textColor="#B0BEC5"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- bottom dock: fixed height reserved in the layout flow.
             v1.7: no bar background anymore (the old dock_gradient is
             gone) — the glass tiles float directly on the wallpaper. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="114dp">

            <HorizontalScrollView
                android:id="@+id/dockScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/dockRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:paddingStart="21dp"
                    android:paddingEnd="21dp" />
            </HorizontalScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- top-right: Input pill + gear icon only -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/inputBtn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/pill_button"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_input"
            android:minWidth="84dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="@string/input_label"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/gearBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/pill_button"
            android:contentDescription="@string/settings_title"
            android:padding="8dp"
            android:src="@drawable/ic_gear" />
    </LinearLayout>
</FrameLayout>
